# Normaliza fim de linha: LF no repositório, independente do SO de quem clona.
# Evita diffs fantasma (arquivo inteiro modificado só por CRLF<->LF).
* text=auto eol=lf

# Binários: nunca normalizar
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.p12   binary
*.jks   binary
*.der   binary

# Scripts: line ending por plataforma de destino
*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Chaves em PEM são texto (LF), mas continuam fora do versionamento (ver .gitignore)
*.pem   text eol=lf
